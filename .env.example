# Optional natural-language polishing. Core scheduling works when disabled.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=5

# SQLite file used by the single-service app.
DATABASE_URL=sqlite:///./data/optishift.db

# Browser origins allowed during local Vite development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deterministic solver configuration.
SOLVER_MAX_TIME_SECONDS=10
SOLVER_RANDOM_SEED=42

