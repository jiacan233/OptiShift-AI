# Runtime mode. Production requires a MySQL DATABASE_URL and never falls back to SQLite.
APP_ENV=development

# Local development:
DATABASE_URL=sqlite:///./data/optishift.db
# Production example (do not commit real credentials):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

# CloudBase Run service port.
PORT=8080

# OpenAI-compatible structured Agent routing. Trusted quick actions and the
# deterministic solver remain available when disabled.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_CONNECT_TIMEOUT_SECONDS=8
LLM_READ_TIMEOUT_SECONDS=50
LLM_WRITE_TIMEOUT_SECONDS=50
LLM_POOL_TIMEOUT_SECONDS=8

# Execution budget and stale-owner lease are separate; the lease is renewed while working.
AGENT_TURN_TIMEOUT_SECONDS=90
AGENT_TURN_LEASE_SECONDS=180

# Browser origins allowed during local Vite development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deterministic solver configuration.
SOLVER_MAX_TIME_SECONDS=10
SOLVER_RANDOM_SEED=42
